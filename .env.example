# JEV 設定範例：複製成 .env 再填入（.env 已被 git 排除，不會提交；不要把金鑰貼到對話或文件裡）
#   copy .env.example .env
# 環境變數優先於 .env。檢查目前設定：python -m jev config（金鑰只顯示前後幾個字元，不會連網）

# ---------- 本機 JEV ----------
# 本機 API 金鑰；留空 = 預設 dev-local-key（只在 127.0.0.1 可連）
JEV_API_KEY=
# 資料庫位置
JEV_DB=data/jev.db

# ---------- 決策模型（D-020） ----------
# 要用哪一家：none（預設，不呼叫任何外部模型）、openai、openrouter、typesafe
JEV_DECISION_PROVIDER=none
# 允許送到外部模型的資料（預設都不允許；兩者都是 false 時，即使設了 provider 也不會送出任何東西）
#   文字：刊登的房屋欄位與說明文字（不含仲介姓名、電話）
#   圖片：刊登照片、格局圖（只在記憶體中轉成 base64 送出，不存進 repo）
JEV_DECISION_ALLOW_TEXT=false
JEV_DECISION_ALLOW_IMAGES=false
# 單次請求逾時（秒）
JEV_DECISION_TIMEOUT_SEC=30
# 每月花費上限（美元）；達到就停止呼叫。填 none 表示不限（不建議）
JEV_DECISION_MONTHLY_BUDGET_USD=1

# --- OpenAI Decisions API（文字＋圖片；和 ChatGPT Plus 分開計費，需要 platform.openai.com 的 API 金鑰）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DECISION_MODEL=gpt-6-luna

# --- OpenRouter（用同一把金鑰呼叫多家決策模型；費用從 OpenRouter 儲值扣）
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 決策模型 ID（注意：typesafe/jev-router 是聊天模型的路由器，不是決策模型）
#   typesafe/jev-1.14      TypeSafe Jev 最新版（OpenRouter 官方文件確認；經 OpenRouter 可收圖片，早期功能）
#   ~typesafe/jev-latest   別名，永遠指向最新版 Jev
#   openai/gpt-6-luna-decisions   OpenAI 的決策模型（2026-10-19 實測：用 systemone 格式可以呼叫；decisions 格式目前回 400）
OPENROUTER_DECISION_MODEL=typesafe/jev-1.14
# 請求格式：systemone（Jev 格式，/api/v1/systemone，預設）或 decisions（/api/alpha/decisions）
OPENROUTER_WIRE_FORMAT=systemone
# decisions 格式的端點（OpenRouter 放在 alpha 路徑）
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# OpenRouter 建議填寫的識別資訊（選填）
OPENROUTER_APP_TITLE=JEV

# --- TypeSafe Jev（只支援文字；需要早期存取的金鑰）
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# jev-latest（目前指向 jev-1.13.0）或 jev-preview（jev-1.14.0）
TYPESAFE_MODEL=jev-latest

# ---------- 通知（Q-005，尚未決定管道；不填就寫入 outbox 資料夾） ----------
JEV_SMTP_HOST=
JEV_SMTP_PORT=587
JEV_SMTP_USER=
JEV_SMTP_PASSWORD=
JEV_SMTP_FROM=
JEV_SMTP_TO=
# Telegram（通知規則的 channel 設為 TELEGRAM 時使用；不填就寫入 outbox）
JEV_TELEGRAM_BOT_TOKEN=
JEV_TELEGRAM_CHAT_ID=
